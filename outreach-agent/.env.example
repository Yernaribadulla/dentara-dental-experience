# LM Studio (local only)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-vl-8b

# Demo link and sender identity
DENTARA_DEMO_URL=
SENDER_NAME=
SENDER_BRAND=
SENDER_CONTACT=

# SMTP is disabled until explicitly enabled in Settings / environment.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SEND_DELAY_SECONDS=30
